# Backend (copy to backend/.env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumera
PORT=4000
FRONTEND_URL=http://localhost:3000
ADMIN_API_KEY=replace-with-a-long-random-value

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_ADMIN_API_KEY=replace-with-the-same-development-value
